{
  "name": "Lead capture: form -> AI score -> Sheets -> Telegram",
  "nodes": [
    {
      "id": "1",
      "name": "Lead form webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "lead-form",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-form",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "submitted_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "name",
              "value": "={{ ($json.body.name || '').trim() }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "email",
              "value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "phone",
              "value": "={{ ($json.body.phone || '').trim() }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "budget",
              "value": "={{ $json.body.budget || '' }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "message",
              "value": "={{ ($json.body.message || '').slice(0, 2000) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "AI classify lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: \"You score inbound sales leads. Reply with JSON only: {\\\"quality\\\": \\\"hot\\\" | \\\"warm\\\" | \\\"cold\\\", \\\"reason\\\": \\\"<one short sentence>\\\"}. hot = clear need + budget + timeline; warm = real interest but vague; cold = spam, no need or no contact info.\" }, { role: 'user', content: JSON.stringify($json) } ] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "OpenAI header auth (Authorization: Bearer YOUR_KEY)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "4",
      "name": "Merge AI result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const lead = $('Normalize lead').item.json;\nlet ai = { quality: 'unknown', reason: 'AI response could not be parsed' };\ntry {\n  ai = JSON.parse($json.choices[0].message.content);\n} catch (e) {}\nreturn [{ json: { ...lead, quality: ai.quality, ai_reason: ai.reason } }];"
      }
    },
    {
      "id": "5",
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "6",
      "name": "Notify on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "={{ { hot: '🔥', warm: '🙂', cold: '🧊' }[$json.quality] || '❔' }} New lead: {{ String($json.quality).toUpperCase() }}\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\nBudget: {{ $json.budget }}\nMessage: {{ $json.message }}\n\nAI: {{ $json.ai_reason }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram bot"
        }
      }
    }
  ],
  "connections": {
    "Lead form webhook": {
      "main": [
        [
          {
            "node": "Normalize lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize lead": {
      "main": [
        [
          {
            "node": "AI classify lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI classify lead": {
      "main": [
        [
          {
            "node": "Merge AI result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge AI result": {
      "main": [
        [
          {
            "node": "Append to Google Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append to Google Sheet": {
      "main": [
        [
          {
            "node": "Notify on Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
